<section class="page front" id="anchor-toc">
  <h1>Table of Contents</h1>
  <div class="rule"></div>
  <ul class="toc-list">
    {% if ctx.acknowledgement %}
      <li><a class="toc-entry" href="#anchor-ack">Acknowledgement</a></li>
    {% endif %}
    {% if ctx.abstract %}
      <li><a class="toc-entry" href="#anchor-abstract">Abstract</a></li>
    {% endif %}
    {% for ch in ctx.chapters %}
      <li><a class="toc-entry" href="#anchor-chapter-{{ loop.index }}">{{ ch.heading }}</a></li>
    {% endfor %}
    {% if ctx.gallery_images %}
      <li><a class="toc-entry" href="#anchor-gallery">Project Image Gallery</a></li>
    {% endif %}
    {% if ctx.has_appendices %}
      <li><a class="toc-entry" href="#anchor-appendices">Appendices</a></li>
    {% endif %}
    <li><a class="toc-entry" href="#anchor-references">References</a></li>
  </ul>
</section>